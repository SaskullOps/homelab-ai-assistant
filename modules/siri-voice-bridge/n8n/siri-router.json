        "id": "a1000000-0000-4000-8000-000000000008",
        "name": "Extract",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1580,
          -40
        ],
        "parameters": {
          "jsCode": "const c = $input.first().json?.choices?.[0]?.message?.content;\n// Some local reasoning models prepend <think>...</think>; never speak that.\nconst reply = typeof c === \"string\" ? c.replace(/<think>[\\s\\S]*?<\\/think>/g, \"\").trim() : \"\";\nreturn [{ json: { reply: reply || \"The assistant did not answer. Try again in a moment.\" } }];"
        }
