          800,
          100
        ],
        "parameters": {
          "jsCode": "const text = $input.first().json.text || \"\";\nconst valid = text.length > 0 && text.length <= 1000;\nlet sessionId = \"\";\nif (valid) {\n  // Rolling conversation id: renewed after 15 minutes of silence.\n  const sd = $getWorkflowStaticData('global');\n  const now = Date.now();\n  if (!sd.sessionId || !sd.lastAt || now - sd.lastAt > 15 * 60 * 1000) {\n    sd.sessionId = 'siri-' + now.toString(36);\n  }\n  sd.lastAt = now;\n  sessionId = sd.sessionId;\n}\nreturn [{ json: { text, valid, sessionId } }];"
        }
      },
