        "parameters": {
          "jsCode": "const b = $input.first().json.body || {};\nlet action = typeof b.action === \"string\" ? b.action.trim().toLowerCase() : \"\";\nconst text = typeof b.text === \"string\" ? b.text.trim() : \"\";\nif (!action) action = \"ask\";\nreturn [{ json: { action, text } }];"
