          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL, stream: false, user: $json.sessionId, messages: [ { role: \"system\", content: $env.LLM_SYSTEM_PROMPT || \"You are a voice assistant. The user spoke through Siri or an Apple Watch and your answer will be read aloud. Answer in the user's language, in 1 to 3 short sentences, with no markdown, lists, links or emojis.\" }, { role: \"user\", content: $json.text } ] }) }}",
          "options": {
            "timeout": 50000
          }
        },
        "onError": "continueErrorOutput",
        "credentials": {
          "httpHeaderAuth": {
            "id": "LlmApiKey0001",
            "name": "LLM API key"
          }
        }
