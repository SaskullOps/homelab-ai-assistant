[Unit]
Description=Spoken status sentence (%i)

[Service]
DynamicUser=yes
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=30
RuntimeMaxSec=10
ExecStart=/usr/local/lib/siri-bridge/status-handler.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ProtectKernelTunables=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
LockPersonality=yes
