# Copy to .env and fill in. Never commit .env.

# --- n8n -------------------------------------------------------------
# Host port, bound to 127.0.0.1 only.
N8N_PORT=5678
# 32+ random characters. Encrypts credentials stored by n8n.
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# --- Bridge security -------------------------------------------------
# Random, unguessable webhook path (A-Z a-z 0-9 _ -), at least 16 chars.
#   openssl rand -hex 12
SIRI_ROUTER_PATH=
# Shared secret sent by the Shortcut in the X-Siri-Token header.
#   openssl rand -hex 24
SIRI_TOKEN=

# --- ask: any OpenAI-compatible chat endpoint ------------------------
# Ollama on the host:   http://host.docker.internal:11434/v1
# LiteLLM / OpenAI / an agent API server: its /v1 base URL.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1:8b
# Bearer token for the endpoint. Ollama ignores it; keep any non-empty value.
LLM_API_KEY=none
# Optional: replace the default spoken-answer system prompt.
LLM_SYSTEM_PROMPT=

# --- Optional hooks (leave empty to answer "not configured") ---------
# GET returns a plain-text sentence describing the status.
STATUS_URL=
# GET sends a Wake-on-LAN packet.
WAKE_URL=
